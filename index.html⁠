<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ClawSight - Top-Down Test</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            background-color: #121212;
            color: #00ffcc;
            font-family: sans-serif;
            overflow: hidden;
        }
        #ui-panel {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 100;
            background: rgba(0, 0, 0, 0.85);
            padding: 12px;
            border: 1px solid #00ffcc;
            border-radius: 8px;
            width: 280px;
        }
        h1 { font-size: 14px; margin: 0 0 6px 0; color: #00ffcc; }
        p { font-size: 11px; margin: 0 0 10px 0; color: #aaa; }
        .btn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        button {
            background: #00ffcc;
            color: #000;
            border: none;
            padding: 8px;
            font-size: 11px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
        }
        button:active { background: #00b38f; }
        button.reset { background: #ff3366; color: #fff; grid-column: span 2; }
        #status { font-size: 12px; font-weight: bold; color: #00ffcc; margin-top: 8px; text-align: center; }
        #canvas-container { width: 100vw; height: 100vh; position: absolute; top:0; left:0; }
    </style>
</head>
<body>

    <div id="ui-panel">
        <h1>ClawSight (Top-Down)</h1>
        <p>真上視点：青緑＝軽い / 赤＝重い<br>灰＝橋渡しバー2本</p>
        <div class="btn-grid">
            <button id="btn-tl">左奥を引く</button>
            <button id="btn-tr">右奥を引く</button>
            <button id="btn-push">中央を押す</button>
            <button id="btn-br">右手前を引く</button>
            <button id="btn-reset" class="reset">リセット</button>
        </div>
        <div id="status">準備中...</div>
    </div>

    <div id="canvas-container"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
    <script>
        // 読み込み完了まで安全に待機する処理
        window.addEventListener('load', function() {
            if (typeof Matter === 'undefined') {
                document.getElementById('status').innerText = "エラー: ライブラリ読込失敗";
                document.getElementById('status').style.color = "#ff3366";
                return;
            }

            const { Engine, Render, Runner, Bodies, Body, Composite, Events, Vector } = Matter;

            const engine = Engine.create();
            engine.world.gravity.x = 0;
            engine.world.gravity.y = 0; // 真上視点のため重力ゼロ

            const container = document.getElementById('canvas-container');
            const render = Render.create({
                element: container,
                engine: engine,
                options: {
                    width: window.innerWidth,
                    height: window.innerHeight,
                    wireframes: false,
                    background: '#121212'
                }
            });

            Render.run(render);
            const runner = Runner.create();
            Runner.run(runner, engine);

            let prizeBox;
            let isFallen = false;
            const barGap = 130;
            const barWidth = 16;
            const barLength = 400;

            function initGame() {
                Composite.clear(engine.world);
                Engine.clear(engine);
                isFallen = false;

                const statusEl = document.getElementById('status');
                statusEl.innerText = "Status: バーの上 (ON BARS)";
                statusEl.style.color = "#00ffcc";

                const cx = window.innerWidth / 2;
                const cy = window.innerHeight / 2;

                // バー2本
                const barL = Bodies.rectangle(cx - barGap/2, cy, barWidth, barLength, { isStatic: true, render: { fillStyle: '#555' } });
                const barR = Bodies.rectangle(cx + barGap/2, cy, barWidth, barLength, { isStatic: true, render: { fillStyle: '#555' } });

                // 箱（重心右寄り）
                const pLight = Bodies.rectangle(cx - 20, cy, 140, 80, { render: { fillStyle: '#00ffcc' } });
                const pHeavy = Bodies.rectangle(cx + 50, cy - 5, 50, 70, { density: 0.08, render: { fillStyle: '#ff0055' } });

                prizeBox = Body.create({
                    parts: [pLight, pHeavy],
                    frictionAir: 0.05,
                    restitution: 0.1
                });

                Composite.add(engine.world, [barL, barR, prizeBox]);
            }

            initGame();

            // 判定ロジック
            Events.on(engine, 'afterUpdate', function() {
                if (!prizeBox || isFallen) return;

                const cx = window.innerWidth / 2;
                const leftBarX = cx - barGap/2;
                const rightBarX = cx + barGap/2;

                let hasLeftSupport = false;
                let hasRightSupport = false;

                for (let v of prizeBox.vertices) {
                    if (v.x <= leftBarX + 15) hasLeftSupport = true;
                    if (v.x >= rightBarX - 15) hasRightSupport = true;
                }

                const angle = prizeBox.angle;
                const effectiveWidth = 190 * Math.abs(Math.cos(angle)) + 80 * Math.abs(Math.sin(angle));

                if ((!hasLeftSupport || !hasRightSupport) && effectiveWidth < barGap + 10) {
                    isFallen = true;
                    const statusEl = document.getElementById('status');
                    statusEl.innerText = "Status: 落下・ハマり！";
                    statusEl.style.color = "#ff0055";

                    Body.setStatic(prizeBox, true);
                }
            });

            // ボタンイベント
            document.getElementById('btn-tl').onclick = function() {
                if (!prizeBox || isFallen) return;
                const pos = Vector.add(prizeBox.position, Vector.rotate({ x: -70, y: -30 }, prizeBox.angle));
                Body.applyForce(prizeBox, pos, Vector.rotate({ x: 0.02, y: 0.03 }, prizeBox.angle));
            };

            document.getElementById('btn-tr').onclick = function() {
                if (!prizeBox || isFallen) return;
                const pos = Vector.add(prizeBox.position, Vector.rotate({ x: 70, y: -30 }, prizeBox.angle));
                Body.applyForce(prizeBox, pos, Vector.rotate({ x: -0.02, y: 0.03 }, prizeBox.angle));
            };

            document.getElementById('btn-push').onclick = function() {
                if (!prizeBox || isFallen) return;
                Body.applyForce(prizeBox, prizeBox.position, Vector.rotate({ x: 0, y: -0.05 }, prizeBox.angle));
            };

            document.getElementById('btn-br').onclick = function() {
                if (!prizeBox || isFallen) return;
                const pos = Vector.add(prizeBox.position, Vector.rotate({ x: 70, y: 30 }, prizeBox.angle));
                Body.applyForce(prizeBox, pos, Vector.rotate({ x: -0.03, y: 0.04 }, prizeBox.angle));
            };

            document.getElementById('btn-reset').onclick = initGame;
        });
    </script>
</body>
</html>
